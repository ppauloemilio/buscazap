# Freemium + novo perfil de anunciante (card/página/painel).
# true = ligado | false ou ausente = comportamento antigo (rollback rápido)
# NEXT_PUBLIC_NEW_AD_PROFILE="true"

# Banco PostgreSQL no Neon — confira com: SELECT current_database();
# Pooler (runtime na Vercel) — host com "-pooler", pgbouncer=true
# connection_limit/pool_timeout: o app aplica defaults se omitidos
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/buscazapp?sslmode=require&pgbouncer=true"
# Conexão direta (migrations) — host sem "-pooler"
DIRECT_URL="postgresql://user:password@host.neon.tech/buscazapp?sslmode=require"

# URL pública do app (webhooks PIX)
APP_URL="https://www.buscazapp.com.br"
NEXT_PUBLIC_APP_URL="https://www.buscazapp.com.br"

# PIX — desenvolvimento (código estático + botão simular)
PIX_PROVIDER="static"
PIX_ENABLE_SIMULATE="true"
PIX_WEBHOOK_SECRET="change-me-in-production"

# PIX — produção com Mercado Pago
# PIX_PROVIDER="mercadopago"
# PIX_ENABLE_SIMULATE="false"
# MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
# MERCADOPAGO_TEST_PAYER_EMAIL="test_user_123456@testuser.com"
# PIX_WEBHOOK_SECRET="chave-forte-para-webhook-interno"

# Assinaturas recorrentes (app Mercado Pago SEPARADA — produto Assinaturas)
# NÃO reutilize MERCADOPAGO_ACCESS_TOKEN aqui (isso quebraria o PIX).
# Checkout usa assinatura SEM plano (pending + init_point) — valores vêm de PRICING.
# MERCADOPAGO_SUBSCRIPTIONS_ACCESS_TOKEN="TEST-..." # depois APP_USR-...
# MERCADOPAGO_SUBSCRIPTIONS_WEBHOOK_SECRET="..."
# Opcional (legado / referência; não exigidos pelo checkout):
# MERCADOPAGO_PLAN_BASIC_ID="..."
# MERCADOPAGO_PLAN_PLUS_ID="..."
# Webhook da app Assinaturas (NÃO use a URL do PIX):
#   https://buscazapp.com.br/api/webhooks/mercadopago-subscriptions


# Upload de fotos dos anúncios (Vercel Blob — obrigatório em produção)
# Crie um Blob Store no painel da Vercel e vincule ao projeto.
# A Vercel adiciona BLOB_STORE_ID (OIDC) e, opcionalmente, BLOB_READ_WRITE_TOKEN.
# Use "private" para stores privados (padrao) ou "public" para stores publicos.
# BLOB_ACCESS="private"
# BLOB_STORE_ID="store_..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Recuperação de senha (Resend — https://resend.com)
# RESEND_API_KEY="re_..."
# RESEND_FROM_EMAIL="BuscaZapp <noreply@buscazapp.com.br>"

# OTP de reivindicação de anúncio (opcional). Sem isso, o dono usa o link
# "Reivindique o anúncio" da mensagem do cadastro rápido.
# WHATSAPP_OTP_WEBHOOK_URL="https://seu-gateway/send"
# ou Evolution API:
# EVOLUTION_API_URL="https://..."
# EVOLUTION_API_KEY="..."
# EVOLUTION_INSTANCE="..."
