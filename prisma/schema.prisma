generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Provider {
  id                    String          @id @default(cuid())
  name                  String
  email                 String?         @unique
  whatsapp              String          @unique
  passwordHash          String
  role                  String          @default("PROVIDER")
  status                String          @default("ACTIVE")
  age                   Int?
  state                 String?
  city                  String?
  neighborhood          String?
  bio                   String?
  businessHours         String?
  responseHint          String?
  referralCode          String          @unique
  freePremiumCredits    Int             @default(0)
  referredById          String?
  referredBy            Provider?       @relation("ProviderReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals             Provider[]      @relation("ProviderReferrals")
  subscriptionExpiresAt DateTime?
  /** BASIC (padrão) ou PLUS — promoções só no PLUS com assinatura ativa. */
  subscriptionTier      String          @default("BASIC")
  /** SIMPLE = UX listagem grátis; FULL = painel completo (permanece após vencimento). */
  listingProfile        String          @default("SIMPLE")
  /** ID da assinatura recorrente no Mercado Pago (preapproval). */
  mpRecurringId         String?         @unique
  /** pending | authorized | paused | cancelled */
  mpRecurringStatus     String?
  /** BASIC | PLUS — plano da recorrência ativa/pendente. */
  mpRecurringTier       String?
  mpRecurringUpdatedAt  DateTime?
  /** Token do link "Reivindique" enviado no WhatsApp (cadastro admin). */
  claimToken            String?         @unique
  claimTokenExpiresAt   DateTime?
  /** Quando o dono confirmou posse do perfil. */
  claimVerifiedAt       DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  advertisements        Advertisement[]
  companyImages         ProviderImage[]
  promotions            ProviderPromotion[]
  coupons               ProviderCoupon[]
  payments              Payment[]
  subscriptions         Subscription[]
  auditLogs             AuditLog[]
  passwordResetTokens   PasswordResetToken[]
  claimRequests         ProviderClaimRequest[]
  referralsMade         Referral[]      @relation("ReferralsMade")
  referralReceived      Referral?       @relation("ReferralReceived")
}

/**
 * Pedido de reivindicação: dono envia código ao WhatsApp do BuscaZapp;
 * admin confere e aprova enviando usuário + senha temporária.
 */
model ProviderClaimRequest {
  id           String    @id @default(cuid())
  providerId   String
  provider     Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  whatsapp     String
  /** Código de referência (ex.: 482913) — aparece como BZ-482913 na mensagem. */
  code         String
  /** PENDING | APPROVED | REJECTED */
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([providerId, status])
}

model ProviderImage {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([providerId, sortOrder])
}

model ProviderPromotion {
  id            String   @id @default(cuid())
  providerId    String
  provider      Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title         String
  description   String
  imageUrl      String?
  priceOriginal Float
  pricePromo    Float
  startsAt      DateTime
  endsAt        DateTime
  isEnabled     Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([providerId, sortOrder])
}

model ProviderCoupon {
  id                String             @id @default(cuid())
  providerId        String
  provider          Provider           @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title             String
  description       String
  /** Texto do selo (ex.: "10% OFF", "R$20 OFF"). */
  badgeLabel        String
  quantityTotal     Int
  quantityRemaining Int
  startsAt          DateTime
  endsAt            DateTime
  isEnabled         Boolean            @default(true)
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  redemptions       CouponRedemption[]

  @@index([providerId, sortOrder])
  @@index([isEnabled, endsAt])
}

model CouponRedemption {
  id        String         @id @default(cuid())
  couponId  String
  coupon    ProviderCoupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  /** Código único exibido ao cliente (ex.: BZ-A9K2). */
  code      String         @unique
  /** ISSUED | USED */
  status    String         @default("ISSUED")
  issuedAt  DateTime       @default(now())
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([couponId, status])
  @@index([issuedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  providerId String
  provider   Provider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([providerId, createdAt])
}

model Advertisement {
  id               String         @id @default(cuid())
  providerId       String
  provider         Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)
  title            String
  description      String
  type             String
  status           String         @default("APPROVED")
  category         String
  isCustomCategory Boolean        @default(false)
  city             String
  state            String
  neighborhood     String?
  serviceArea      String         @default("CITY_WIDE")
  streetAddress             String?
  instagram                 String?
  website                   String?
  /** JSON: { "0": "08:00-18:00", ... } domingo=0 .. sábado=6; null = fechado */
  businessHoursJson         String?
  whatsappNumber   String
  whatsappLabel             String?
  secondaryWhatsappNumber   String?
  secondaryWhatsappLabel    String?
  slug             String?        @unique
  rating           Float          @default(0)
  reviewCount      Int            @default(0)
  premiumExpiresAt DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  premiumBoosts    PremiumBoost[]
  images           AdvertisementImage[]
  products         AdvertisementProduct[]
  services         AdvertisementService[]
  reviews          Review[]
  analyticsEvents  AnalyticsEvent[]

  @@index([status, category])
  @@index([status, city])
  @@index([status, createdAt])
  @@index([providerId])
}

model AdvertisementProduct {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  title           String
  price           Float
  imageUrl        String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([advertisementId, sortOrder])
}

model AdvertisementService {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  title           String
  description     String
  priceFrom       Float?
  imageUrl        String?
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([advertisementId, sortOrder])
}

model AnalyticsEvent {
  id              String         @id @default(cuid())
  type            String
  path            String?
  advertisementId String?
  advertisement   Advertisement? @relation(fields: [advertisementId], references: [id], onDelete: SetNull)
  metadata        String?
  createdAt       DateTime       @default(now())

  @@index([type, createdAt])
  @@index([advertisementId, type, createdAt])
  @@index([createdAt])
}

model Review {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  authorName      String
  rating          Int
  comment         String?
  createdAt       DateTime      @default(now())

  @@index([advertisementId])
}

model AdvertisementImage {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  url             String
  kind            String        @default("GALLERY")
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@index([advertisementId, kind])
}

model Subscription {
  id         String   @id @default(cuid())
  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  amount     Float
  startsAt   DateTime
  expiresAt  DateTime
  paymentId  String   @unique
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model PremiumBoost {
  id              String        @id @default(cuid())
  advertisementId String
  advertisement   Advertisement @relation(fields: [advertisementId], references: [id], onDelete: Cascade)
  providerId      String
  amount          Float         @default(0)
  source          String        @default("PAID")
  startsAt        DateTime
  expiresAt       DateTime
  paymentId       String?       @unique
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

model Referral {
  id         String   @id @default(cuid())
  referrerId String
  referrer   Provider @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId String   @unique
  referred   Provider @relation("ReferralReceived", fields: [referredId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([referrerId, createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  providerId   String
  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  type         String
  amount       Float
  status       String        @default("PENDING")
  pixTxId      String        @unique
  pixCopyPaste String
  referenceId  String?
  paidAt       DateTime?
  expiresAt    DateTime
  createdAt    DateTime      @default(now())
  subscription Subscription?
  premiumBoost PremiumBoost?
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      Provider @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action     String
  entityType String
  entityId   String?
  metadata   String?
  createdAt  DateTime @default(now())
}

model Report {
  id               String   @id @default(cuid())
  advertisementRef String
  reason           String
  details          String?
  status           String   @default("OPEN")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CatalogCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   @default("🏷️")
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CategorySuggestion {
  id             String   @id @default(cuid())
  name           String
  normalizedKey  String   @unique
  status         String   @default("PENDING")
  mergedIntoName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CatalogState {
  id        String       @id @default(cuid())
  uf        String       @unique @db.VarChar(2)
  name      String       @unique
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  cities    CatalogCity[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model CatalogCity {
  id        String       @id @default(cuid())
  name      String
  stateId   String
  state     CatalogState @relation(fields: [stateId], references: [id], onDelete: Cascade)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([name, stateId])
}

model HomepageSetting {
  id                    String   @id @default("default")
  showUrgentSearches    Boolean  @default(false)
  showPopularCategories Boolean  @default(false)
  showCityExplorer      Boolean  @default(false)
  showPromotions        Boolean  @default(false)
  showCoupons           Boolean  @default(false)
  showPremiumAds        Boolean  @default(true)
  showPaidAds           Boolean  @default(true)
  showFreeAds           Boolean  @default(true)
  /** JSON array de ids das seções da home */
  sectionOrderJson      String   @default("[\"popularCategories\",\"urgentSearches\",\"promotions\",\"coupons\",\"premiumAds\",\"paidAds\",\"freeAds\",\"cityExplorer\"]")
  plusPlanEnabled       Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model ProviderLead {
  id                     String   @id @default(cuid())
  name                   String
  whatsapp               String
  whatsappLabel          String?
  secondaryWhatsapp      String?
  secondaryWhatsappLabel String?
  city                   String
  state                  String   @default("PA")
  neighborhood           String?
  serviceArea            String
  adTitle                String
  description            String?
  photoUrl               String?
  status                 String   @default("NEW")
  notes                  String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([status, createdAt])
  @@index([whatsapp, createdAt])
}
